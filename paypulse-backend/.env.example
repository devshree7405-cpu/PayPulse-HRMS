# Copy this file to .env and fill in real values. Never commit .env.

# MySQL Workbench default: host=127.0.0.1, port=3306
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/hr_system

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call this API from the browser
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
